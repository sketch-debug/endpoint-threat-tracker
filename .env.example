# Copy to .env and edit. NEVER commit .env. Secrets and webhook URLs live here, never in code.
# Signs session cookies. Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-value

# --- Email alerts (SMTP). Leave empty to disable the email channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# --- Microsoft Teams / Power Automate webhook. Leave empty to disable.
TEAMS_WEBHOOK_URL=

# --- Bootstrap admin password used on FIRST startup when no users exist yet.
# Change this BEFORE the first start on a shared server; change the password in
# the dashboard immediately after first login if you left the default.
TRACKER_ADMIN_PASSWORD=admin1234
